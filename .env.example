# Copie este arquivo para .env e preencha com os dados dos projetos Supabase.
# O .env está no .gitignore: NUNCA commite senhas ou chaves.
# Usado por: docker compose -f docker-compose.yml -f docker-compose.supabase.yml ...

# ---------- Projeto Supabase "documentos" ----------
# Botão "Connect" > Session pooler (porta 5432, funciona em IPv4). Copie a URL exata e troque [SENHA].
DOCUMENTOS_DATABASE_URL=postgresql://postgres.<ref-documentos>:[SENHA]@<host-do-pooler>.pooler.supabase.com:5432/postgres?sslmode=require

# Storage > Settings > S3 Connection (endpoint e região) e "New access key".
DOCUMENTOS_S3_ENDPOINT=https://<ref-documentos>.storage.supabase.co/storage/v1/s3
DOCUMENTOS_S3_REGION=<regiao>
DOCUMENTOS_S3_ACCESS_KEY=
DOCUMENTOS_S3_SECRET_KEY=
DOCUMENTOS_S3_BUCKET=documentos

# ---------- Projeto Supabase "prontuario" ----------
PRONTUARIO_DATABASE_URL=postgresql://postgres.<ref-prontuario>:[SENHA]@<host-do-pooler>.pooler.supabase.com:5432/postgres?sslmode=require

# ---------- Projeto Supabase "especialidades" (Python) ----------
# Mesmo passo a passo: Connect > Session pooler. Use "memoria" para rodar sem banco.
ESPECIALIDADES_DATABASE_URL=postgresql://postgres.<ref-especialidades>:[SENHA]@<host-do-pooler>.pooler.supabase.com:5432/postgres?sslmode=require
